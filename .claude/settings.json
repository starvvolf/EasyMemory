{
  "permissions": {
    "deny": [
      "Read(./보관/**)",
      "Read(./eval/runs/**)",
      "Read(./eval/snapshots/**)",
      "Read(./tools/problem-authoring-lab/runs/**)",
      "Read(./.study-forge-data/**)",
      "Read(./.env.local)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/work/claim-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
