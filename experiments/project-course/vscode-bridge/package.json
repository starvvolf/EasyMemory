{
  "name": "recaller-bridge",
  "displayName": "Recaller 튜터 연결",
  "description": "Recaller 프로젝트 코스의 튜터를 VS Code 오른쪽 탭에 띄우고, 지금 보는 코드를 튜터에게 알려 주고 튜터가 보낸 줄 열기·빈칸 넣기를 한다.",
  "version": "0.6.0",
  "publisher": "recaller-local",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/starvvolf/EasyMemory"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Education"
  ],
  "activationEvents": [
    "workspaceContains:.recaller/stage.json",
    "workspaceContains:.recaller/lobby.json"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "recaller.openTutor",
        "title": "Recaller: 튜터를 옆에 열기"
      },
      {
        "command": "recaller.what",
        "title": "Recaller: 이건 뭐예요?"
      },
      {
        "command": "recaller.ask",
        "title": "Recaller: 튜터에게 이 코드 묻기"
      },
      {
        "command": "recaller.reconnect",
        "title": "Recaller: 튜터에 다시 연결"
      },
      {
        "command": "recaller.explainBlock",
        "title": "Recaller: 이 덩어리 설명해 줘"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "recaller.what",
          "group": "navigation@0",
          "when": "recaller.connected"
        },
        {
          "command": "recaller.explainBlock",
          "group": "navigation@0",
          "when": "recaller.connected && editorHasSelection"
        },
        {
          "command": "recaller.ask",
          "group": "navigation@1",
          "when": "recaller.connected"
        }
      ]
    },
    "keybindings": [
      {
        "command": "recaller.what",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorTextFocus && recaller.connected"
      },
      {
        "command": "recaller.ask",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && recaller.connected"
      }
    ],
    "configuration": {
      "title": "Recaller",
      "properties": {
        "recaller.openTutorBeside": {
          "type": "boolean",
          "default": true,
          "description": "튜터에 연결되면 오른쪽에 튜터 탭을 자동으로 연다."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "작업 폴더의 파일을 읽고 튜터와 주고받기만 해요."
    },
    "virtualWorkspaces": false
  }
}